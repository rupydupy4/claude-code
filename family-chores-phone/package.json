{
  "name": "family-chores-phone",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Family Chores for one shared device: chores, photo proof and rewards, saved on the device.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "node e2e/run.mjs",
    "icons": "node scripts/make-icons.mjs",
    "assets": "node scripts/make-icons.mjs && capacitor-assets generate --android --ios --iconBackgroundColor #0f766e --iconBackgroundColorDark #0f766e --splashBackgroundColor #f7f7f5 --splashBackgroundColorDark #111316",
    "cap:sync": "npm run build && cap sync",
    "android:debug": "npm run cap:sync && node scripts/android-debug.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "lucide-react": "^1.50.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  }
}
