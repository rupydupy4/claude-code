# Supabase project (Settings → API). The URL and publishable/anon key are safe in the browser:
# row level security decides what each signed-in user can read.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server only. Used to create children's sign-in accounts and to run the demo.
# Never prefix this with NEXT_PUBLIC_ and never import it into client components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Show the "Try the demo" panel on the sign-in page (The Smith Family).
DEMO_MODE=true
